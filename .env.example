# =======================================================
# NKB MANUFACTURING & TRADING - ENVIRONMENT CONFIGURATION
# =======================================================

# Application Environment (production, development, test)
NODE_ENV=production

# Server Port (Hostinger / cloud server environment port)
PORT=3000

# Canonical Application Base URL
APP_URL=https://your-domain.com

# Allowed CORS Origins (comma-separated if multiple)
CORS_ORIGIN=https://your-domain.com

# SQLite Database File Location (relative or absolute)
DATABASE_PATH=./database/nkb.sqlite

# Cryptographic Session & JWT Signing Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS

# Enforce HTTPS-Only Cookies (Set to true in production)
COOKIE_SECURE=true

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
