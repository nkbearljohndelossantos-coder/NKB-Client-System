# =======================================================
# NKB MANUFACTURING & TRADING - ENVIRONMENT CONFIGURATION
# Production Hostinger & Domain: my.nkbmanufacturing.com
# =======================================================

# Application Environment (production, development, test)
NODE_ENV=production

# Database Driver: mysql (Hostinger/phpMyAdmin) or sqlite (local dev)
DB_DRIVER=mysql

# Server Port (Hostinger Passenger / Node.js runtime port)
PORT=3000

# Canonical Application Base URL
APP_URL=https://my.nkbmanufacturing.com

# Allowed CORS Origins
CORS_ORIGIN=https://my.nkbmanufacturing.com

# Database Connection Settings (MySQL / Hostinger phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u335953510_client
DB_PASSWORD=your_mysql_password_here
DB_NAME=u335953510_client_db

# SQLite Database Fallback Location (if using local file driver)
DATABASE_PATH=./database/nkb.sqlite

# Cryptographic Session & JWT Signing Secret (Minimum 32 characters)
JWT_SECRET=nkb-manufacturing-production-jwt-secure-key-2026-b2b-portal

# Enforce HTTPS-Only Cookies (Set to true in production HTTPS)
COOKIE_SECURE=true

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=50
